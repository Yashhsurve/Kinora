# ========================================================
# Kinora - Environment Configuration Template
# ========================================================
# Copy this file to .env and fill in your API keys:
# cp .env.example .env

# Server Port (default: 3000)
PORT=3000

# Google Gemini API Key (Required for AI Chat & Function Calling)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# TMDB API Read Access Token or API Key (v3 auth)
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API Key (For accurate IMDb ratings & votes)
# Get your free key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here
